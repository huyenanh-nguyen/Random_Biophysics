load_file("nrngui.hoc")

create soma, dend
soma {
    nseg = 1
    insert pas
    e_pas = -65
    L = 30
    diam = 30
    Ra = 100
}
//set another segment, because standard is unrealistic, insert passive characteristics and more stuff

dend {
    nseg = 11
    L = 1000
    diam = 2
    insert pas
    g_pas = 0.0001
    e_pas = -65
}

//create a dendrite  with this, which is quite big, especially long but still thin

connect dend (0), soma(1)
//connects end of dendrite  with uppert part of soma

objref listSyn, listStim, listCon
listSyn = new List()
listStim = new List()
listCon = new List()
count = 0
dend {
    for(x,0) {
        listSyn.append(new Exp2Syn(x))
        listStim.append(new NetStim())
        listStim.o(count).start = 100 + count * 50
        listStim.o(count).number = 1
        listCon.append(new NetCon(listStim.o(count), listSyn.o(count), 0, 0, 0.001))
        count +=1
    }
}

