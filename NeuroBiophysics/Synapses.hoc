stim.start = 100
stim.interval = 5
stim.number = 1
stim.noise = 0
nc = new NetCon(stim, syn, 0, 0, 0.001)

//equation: i = g * (v - e)
*/

tstop = 800

objref vrec, trec 
//just name it after voltage recording and time recording
trec = new Vector()
trec.record(&t)
//records any variable that we want 
vrec = new Vector()
vrec.record(&soma.v(0.5))
//specify where exactly it should record

run()

objref vplot
vplot = new Graph()
//possible way for scaling: vplot.size(0,tstop,-65, -60)    but better would be:
vplot.size(0,trec.max(), vrec.min(), vrec.max)
vrec.line(vplot, trec, 1, 2)


