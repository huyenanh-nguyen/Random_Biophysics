load_file("Morphology_L5PC.hoc")

create target_cell // post synaotic neuron (receive synaptic input)

target_cell {
    L  = 30
    diam = 30
}

forall{
    insert pas
    g_pas = 0.00005
    e_pas = -65.0
}

target_cell{
     define_shape()
     for i=0, n3d() - 1 {
          pt3dchange(i, x3d(i) + 100, y3d(i), z3d(i), diam3d(i))
     }
}

objref nclist
nclist = new List() 

objref electrode

soma { 
       insert hh
       electrode = new IClamp(0.5) 
       electrode.del = 10 
       electrode.dur = 5
       electrode.amp = 2.0
} 

objref listSyn, listStim, listCon

listSyn = new List()
listStim = new List()
listCon = new List()
count = 0


maxsyn = 2
objref syn[maxsyn]


//for i=0,  maxsyn-1{
//    syn[i] = new Exp2Syn(0.5)
//}


target_cell syn[0] = new Exp2Syn(0.5) // EPSP on target cell

access soma
forall print secname()

apic[11] syn[1] = new Exp2Syn(0.5) 

soma nclist.append(new NetCon(&v(0.5), syn[0], 3, 2, 0.01)) // NetCon: Soma → target_cell (EPSP)
soma  nclist.append(new NetCon(&v(1), syn[1], 3, 2, 0.01)) // NetCon: Soma → target_cell (EPSP)
//for i = 0, nclist.count()-1 { nclist.object(i).weight = 0.006}


objref sp
sp = new PlotShape() // plotting the Neuron


forall nseg = int(L + 1)

objref vsoma, vapic, vtarget, tvec // recording voltage
vsoma = new Vector()
vapic = new Vector()
vtarget = new Vector()
tvec = new Vector()

vsoma.record(&soma.v(0.5))
vapic.record(&apic[11].v(0.5))
vtarget.record(&target_cell.v(0.5))
tvec.record(&t)



objref g
g = new Graph()
g.size(0, 100, -80, 40)
g.addvar("soma", &soma.v(0.5), 1,1)       // black
g.addvar("apic[11]", &apic[11].v(0.5), 2,1) // red
g.addvar("target_cell", &target_cell.v(0.5), 3,1) // blue
graphList[0].append(g)


dt = 0.025
tstop = 100
v_init = -65
finitialize(v_init)

run()