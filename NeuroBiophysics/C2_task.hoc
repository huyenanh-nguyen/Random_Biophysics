load_file("L5PC.hoc")

create target_cell // post synaotic neuron (receive synaptic input)
create apic[20] // Apikale Dendriten

target_cell {
     L  = 30
     diam = 30
     insert pas
}

target_cell{
     define_shape()
     for i=0, n3d() - 1 {
          pt3dchange(i, x3d(i) + 100, y3d(i), z3d(i), diam3d(i))
     }
}

objref nclist
nclist = new List() 

objref electrode
soma { 
       electrode = new IClamp(0.5) 
       electrode.del = 10 
       electrode.dur = 5
       electrode.amp = 0.5
} 

objref listSyn, listStim, listCon

listSyn = new List()
listStim = new List()
listCon = new List()
count = 0

dend {
    for(x,0) { 
        // iteration over segment x on dendrite (x is the distance of the center of each segment)
        listSyn.append(new Exp2Syn(x)) // adding a Double-exponential synapse to each segment
        
        listStim.append(new NetStim()) // adding a stimulus NetStim = Spike-Generator
        listStim.o(count).start = 100 + count * 50 // timer for timulus, each synapse fires 1 spike with a 50ms  shift
        listStim.o(count).number = 1
        
        listCon.append(new NetCon(listStim.o(count), listSyn.o(count), 0, 0, 0.001)) // building a connection

        count += 1
    }
}

maxsyn = 2
objref syn[2]

target_cell syn[0] = new Exp2Syn(0.5) 

access soma
//forall print secname()

apic[11] syn[0] = new Exp2Syn(0.5) 

soma  nclist.append(new NetCon(&v(1), syn[1], 3, 2, 0.01)) 


objref g

g = new Graph()
g.size(0, tstop, -80, 40)
g.addvar("soma.v(0.5)", &soma.v(0.5), 1, 1)

graphList[0].append(g)
run()