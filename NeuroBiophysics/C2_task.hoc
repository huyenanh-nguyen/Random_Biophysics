load_file("L5PC.hoc")

create target_cell // post synaotic neuron (receive synaptic input)


target_cell {
     L  = 30
     diam = 30
     insert pas
}

target_cell{
     define_shape()
     for i=0, n3d() - 1 {
          pt3dchange(i, x3d(i) + 100, y3d(i), z3d(i), diam3d(i))
     }
}
objref nclist
nclist = new List() 

objref electrode
soma { 
       electrode = new IClamp(0.5) 
       electrode.del = 10 
       electrode.dur = 5
       electrode.amp = 0.5
} 

objref listSyn, listStim, listCon

listSyn = new List()
listStim = new List()
listCon = new List()
count = 0

dend {
    for(x,0) { 
        // x is pos in dend and here 0 start until end, always center segment
        listSyn.append(new Exp2Syn(x)) // x is pos of syn placement
        
        listStim.append(new NetStim())
        listStim.o(count).start = 100 + count * 50 // .o object at specific instance in lists
        listStim.o(count).number = 1
        
        listCon.append(new NetCon(listStim.o(count), listSyn.o(count), 0, 0, 0.001))

        count += 1
    }
}

maxsyn = 2
objref syn[2]

target_cell syn[0] = new Exp2Syn(0.5) 

access dend
forall print secname()

apic[11] syn[1] = new Exp2Syn(0.5) 

dend  nclist.append(new NetCon(&v(1), syn[1], 3, 2, 0.01)) 


objref g

g = new Graph()
g.size(0, tstop, -80, 40)
g.addvar("soma.v(0.6)", &soma.v(0.6), 2, 1)

graphList[0].append(g)
run()