load_file("nrngui.hoc")
ndend = 2
create soma, dend[ndend]

access soma

//Define membrane mechanisms
soma{
    nseg=1
    diam=18.8
    L = 18.8
    Ra=100.0
    insert hh // hh = Hodgkin-Huxley channels
    gnabar_hh= 0.2 // gnabar_hh = The maximum specific sodium channel conductance
    gl_hh = 0.00005 // gl_hh = The maximum specific leakage conductance
    el_hh = -65.0 // el_hh = The reversal potential for the leakage channel
    insert pas // pas = passive channels
    g_pas = 0.00005
    e_pas = -65.0
}


dend[0] { nseg = 5 diam = 3.18 L = 701.9 Ra = 100} // nseg cuts one dendrite, that looks like a cylinder into x pieces
dend[1] { nseg = 5 diam = 2.0 L = 549.1 Ra = 100 }

for i = 0, ndend-1{ 
    dend[i] { 
        insert pas g_pas = 0.00005 e_pas = -65.0 
        }
}

// Connect things together
for i=0, ndend-1 {
    connect dend[i](0) , soma(i)
}

{soma distance(0, 0.5)}  // sets distance origin at soma(0.5)
proc print_section_distances() {local x
    print "Section", secname()
    for (x) {
        printf("  x= %5.3f   distance= %8.3f um", x, distance(x))
    }
}

soma print_section_distances()
dend[0] print_section_distances()
dend[1] print_section_distances()

// create an electrode in the soma
objectvar stim
stim = new IClamp(0.5)
stim.del = 100 // del = The delay until the onset of the stimulus (in ms)
stim.dur = 100 // dur = The duration of the stimulus (in ms)
stim.amp = 0.45 // amp = The amplitude of the stimulus (in nA)


//forall psection()

tstop = 300

//objref g
//g = new Graph()
//g.size(0, tstop, -80, 40)
//g.addvar("soma.v(0.5)", &soma.v(0.5), 6,2)

//sgraphList[0].append(g)

run()