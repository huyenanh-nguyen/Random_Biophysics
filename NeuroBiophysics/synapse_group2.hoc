load_file("nrngui.hoc")

create soma, dend
soma {
    nseg = 1
    insert pas
    e_pas = -65
    L = 30
    diam = 30
    Ra = 100
}

dend {
    nseg = 11
    L = 1000
    diam = 2
    Ra = 100
    insert pas
    g_pas = 0.0001
    e_pas = -65
}

connect dend(0), soma(1)

objref listSyn, listStim, listCon

listSyn = new List()
listStim = new List()
listCon = new List()
count = 0

dend {
    for(x,0) { 
        // x is pos in dend and here 0 start until end, always center segment
        listSyn.append(new Exp2Syn(x)) // x is pos of syn placement
        
        listStim.append(new NetStim())
        listStim.o(count).start = 100 + count * 50 // .o object at specific instance in lists
        listStim.o(count).number = 1
        
        listCon.append(new NetCon(listStim.o(count), listSyn.o(count), 0, 0, 0.001))

        count += 1
    }
}

tstop = 800

objref vrec, trec // create objects to plot outside GUI

trec = new Vector()
trec.record(&t)

vrec = new Vector()
vrec.record(&soma.v(0.5)) // v only works when only one soma and segment rest spefifies

run()

objref vplot // create plot outside GUI
vplot = new Graph()
vplot.size(0, trec.max(), vrec.min(), vrec.max()) //axys size(start x, end x, start y, end y)
vrec.line(vplot, trec, 1, 2) //plot vrec where, against what, thickness, color